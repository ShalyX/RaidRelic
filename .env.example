# RaidRelic host/deployment credentials. Streamers never enter these.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Local default. For a hosted instance set RAIDRELIC_BASE_URL to its HTTPS origin.
RAIDRELIC_BASE_URL=http://localhost:3000
# Optional explicit override; otherwise defaults to <RAIDRELIC_BASE_URL>/auth/callback.
TWITCH_REDIRECT_URI=

# Optional pre-authorized user token instead of the browser OAuth flow:
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=
RAIDRELIC_PUBLIC=0
RAIDRELIC_SIMULATION=0
PORT=3000
